{
  "name": "sepang-vision-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:api": "python -m unittest backend.test_gesture_training",
    "train:gestures": "python -m backend.gesture_training",
    "data:fetch": "python scripts/fetch_openf1.py --meeting 1308",
    "data:build": "python scripts/build_recorded_session.py --meeting 1308",
    "test:pipeline": "python -m unittest discover -s scripts -p \"test_*.py\"",
    "data:align": "node --experimental-strip-types scripts/align_openf1.ts",
    "data:pitlane": "node --experimental-strip-types scripts/derive-pit-lane.ts",
    "check:physics": "node --experimental-strip-types scripts/physics-check.ts race"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
